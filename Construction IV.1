# -*- coding: utf-8 -*-
# 需要: Python 3.8+ 和 pandas
# 功能: 遍历 n,l∈[1,50]，w1,w2∈[0, n-l]，筛选满足
#   l = w2 - w1 + 2
#   0 <= w1 < w2 <= n - l
#   2^(l-1) <= min(C(n-l, w1), C(n-l, w2))
# 的四元组 (n, l, w1, w2)，并输出五元组
#   (n, w2, w1-1, 2^(n-1) - 2^(n-l-1), l+1)

import pandas as pd
from math import comb

rows = []
for n in range(1, 51):
    for l in range(1, 51):
        if l > n:
            continue
        max_w = n - l
        if max_w < 1:   # 需要至少 w2 > w1 >= 0
            continue
        for w1 in range(0, max_w + 1):
            for w2 in range(w1 + 1, max_w + 1):
                if l != (w2 - w1 + 2):
                    continue
                c1 = comb(n - l, w1)
                c2 = comb(n - l, w2)
                if (1 << (l - 1)) <= min(c1, c2):
                    rows.append({
                        "n": n,
                        "w2": w2,
                        "w1-1": w1 - 1,
                        "2^(n-1)-2^(n-l-1)": (1 << (n - 1)) - (1 << (n - l - 1)),
                        "l+1": l + 1
                    })

df = pd.DataFrame(rows).sort_values(["n", "w2", "w1-1", "l+1"]).reset_index(drop=True)

# 导出 CSV
csv_path = "derived_tuples_n_w2_w1m1_nl_expr_lp1_1to50.csv"
df.to_csv(csv_path, index=False)

print(f"总记录数: {len(df)}")
print(f"已保存: {csv_path}")
print(df.head(10))



