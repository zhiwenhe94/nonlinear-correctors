from itertools import product
from math import comb

def wt_int(x: int) -> int:
    return x.bit_count()

def dot_parity(a: int, b: int) -> int:
    # parity of dot product over F2: sum_i a_i b_i mod 2
    return wt_int(a & b) & 1

def anf_eval(x: int, monom_masks):
    """
    Evaluate ANF over F2 at point x (bitmask of length n).
    monom_masks: list of int masks, each mask represents a monomial product of variables in that mask.
    """
    s = 0
    for m in monom_masks:
        # monomial is 1 iff all variables in mask are 1 in x
        s ^= (1 if (x & m) == m else 0)
    return s

def walsh_spectrum(n: int, monom_masks):
    """
    Return list W[omega] for omega in F2^n (as int 0..2^n-1),
    with Walsh transform W_f(omega) = sum_x (-1)^{f(x) + omega·x}.
    """
    N = 1 << n
    # precompute f(x) for all x
    fx = [anf_eval(x, monom_masks) for x in range(N)]
    W = [0] * N
    for omega in range(N):
        s = 0
        for x in range(N):
            e = fx[x] ^ dot_parity(omega, x)
            s += -1 if e else 1
        W[omega] = s
    return W

def compute_t_and_nonlinearity(n: int, monom_masks):
    W = walsh_spectrum(n, monom_masks)

    # Nonlinearity
    max_absW = max(abs(v) for v in W)
    Nf = (1 << (n - 1)) - (max_absW // 2)  # max_absW is even for Boolean functions

    # t via your Lemma: for all t'<=t, sum_{wt(Ω)=t'} W_f(Ω)=0
    layer_sums = []
    for tprime in range(n + 1):
        s = sum(W[omega] for omega in range(1 << n) if wt_int(omega) == tprime)
        layer_sums.append(s)

    t = -1
    for tprime in range(n + 1):
        if layer_sums[tprime] != 0:
            break
        t = tprime

    return t, Nf, max_absW, layer_sums

