import numpy as np

# =========================================================
# 1) Define updated f1, f2 on 4 variables (ANF over F2)
#    Convention: for 4-bit integer v, bits are (x1,x2,x3,x4) with x1 as LSB.
# =========================================================
def f1_val(v: int) -> int:
    x1 = (v >> 0) & 1
    x2 = (v >> 1) & 1
    x3 = (v >> 2) & 1
    x4 = (v >> 3) & 1
    # UPDATED f1: previous cubic+quadratic terms + linear x2+x3+x4
    return ((x1 & x2 & x4) ^ (x1 & x2 & x3) ^ (x3 & x4) ^ (x2 & x3) ^
            (x1 & x4) ^ (x1 & x3) ^ (x1 & x2) ^ x2 ^ x3 ^ x4)

def f2_val(v: int) -> int:
    x1 = (v >> 0) & 1
    x2 = (v >> 1) & 1
    x3 = (v >> 2) & 1
    x4 = (v >> 3) & 1
    # f2 unchanged
    return ((x1 & x2 & x3) ^ (x1 & x3 & x4) ^ (x1 & x2) ^ (x1 & x4) ^
            (x2 & x3) ^ x1 ^ x3 ^ x4)

f1_table = np.array([f1_val(v) for v in range(16)], dtype=np.uint8)
f2_table = np.array([f2_val(v) for v in range(16)], dtype=np.uint8)

# =========================================================
# 2) Build F : F2^20 -> F2^4 from 5 blocks x^1..x^5 (each 4 bits)
# =========================================================
n = 20
N = 1 << n  # 2^20 = 1,048,576
idx = np.arange(N, dtype=np.uint32)

# blocks (x^1..x^5), each is a 4-bit chunk
b1 = (idx >> 0)  & 15
b2 = (idx >> 4)  & 15
b3 = (idx >> 8)  & 15
b4 = (idx >> 12) & 15
b5 = (idx >> 16) & 15

f1b1, f1b2, f1b3, f1b4, f1b5 = f1_table[b1], f1_table[b2], f1_table[b3], f1_table[b4], f1_table[b5]
f2b1, f2b2, f2b3, f2b4, f2b5 = f2_table[b1], f2_table[b2], f2_table[b3], f2_table[b4], f2_table[b5]

# Your definition of F(x) (all + are XOR over F2)
F1 = f1b1 ^ f1b2 ^ f1b3 ^ f1b4
F2 = f2b1 ^ f2b2 ^ f2b3 ^ f2b4
F3 = f1b1 ^ f2b2 ^ f1b3 ^ f2b3 ^ f1b5
F4 = f2b1 ^ f1b2 ^ f2b2 ^ f1b3 ^ f2b5

Fs = np.vstack([F1, F2, F3, F4]).astype(np.uint8)  # shape (4, 2^20)

# =========================================================
# 3) Fast Walsh-Hadamard Transform (FWHT) for Walsh spectrum
#    For a Boolean function f: a[x]=(-1)^{f(x)}, then FWHT(a)[omega]=W_f(omega).
# =========================================================
def fwht_inplace(a: np.ndarray) -> np.ndarray:
    """In-place Walsh-Hadamard transform on 1D int32/int64 array (length power of 2)."""
    nlen = a.shape[0]
    h = 1
    while h < nlen:
        a2 = a.reshape(-1, 2*h)
        x = a2[:, :h]
        y = a2[:, h:2*h]
        tmp = x.copy()
        x[:] = tmp + y
        y[:] = tmp - y
        h *= 2
    return a

def nonlinearity_from_max_walsh(max_absW: int, n: int) -> int:
    return (1 << (n - 1)) - (max_absW // 2)

# =========================================================
# 4) Precompute popcount(weight) of omega for layer sums S_{t'}
# =========================================================
lut8 = np.array([bin(i).count("1") for i in range(256)], dtype=np.uint8)
idx_bytes = idx.view(np.uint8).reshape(-1, idx.itemsize)  # 4 bytes per uint32
pop = lut8[idx_bytes].sum(axis=1).astype(np.uint8)        # popcount for omega=0..2^20-1

# =========================================================
# 5) Compute corrector order t and nonlinearity N_F
# =========================================================
t_u_list = []   # store (u, t_u, layer_sums)
min_N = None
min_u = None

for u in range(1, 16):  # u in F2^{4*}, represented by 1..15
    ubits = np.array([(u >> k) & 1 for k in range(4)], dtype=np.uint8)  # corresponds to (F1,F2,F3,F4)

    # fc[x] = u·F(x) in {0,1}
    fc = ((ubits[:, None] & Fs).sum(axis=0) & 1).astype(np.int8)

    # a[x] = (-1)^{fc[x]} in {+1,-1} as int32
    a = (1 - 2*fc).astype(np.int32)

    # Walsh spectrum: a[omega] = W_{u·F}(omega)
    fwht_inplace(a)

    # nonlinearity of scalar component u·F
    max_absW = int(np.max(np.abs(a)))
    N_u = nonlinearity_from_max_walsh(max_absW, n)
    if min_N is None or N_u < min_N:
        min_N = N_u
        min_u = u

    # layer sums S_{t'}(u) = sum_{wt(omega)=t'} W(omega)
    layer_sums = np.bincount(pop, weights=a.astype(np.int64), minlength=n+1)

    # maximal t_u such that layer_sums[0..t_u] are all zero
    t_u = -1
    for tp in range(n + 1):
        if layer_sums[tp] != 0:
            break
        t_u = tp

    t_u_list.append((u, t_u, layer_sums))

# overall corrector order t is min_u t_u
t_overall = min(tu for (_, tu, _) in t_u_list)

print("=== Corrector order t (Lemma corrWeq1) ===")
if t_overall < 0:
    bad = [(u, layer_sums[0]) for (u, tu, layer_sums) in t_u_list if tu < 0]
    u_bad, s0_bad = bad[0]
    print("F is NOT an (20,4,t)-corrector for any t >= 0.")
    print(f"Witness u = {u_bad} (binary {u_bad:04b}): S_0(u)=W_{'{'}u·F{'}'}(0) = {int(s0_bad)} != 0.")
else:
    print(f"F IS an (20,4,t)-corrector with maximal t = {t_overall}.")

print("\n=== Vector nonlinearity N_F (Definition NF) ===")
print(f"N_F = {min_N}  (attained e.g. at u = {min_u}, binary {min_u:04b})")

# =========================================================
# 6) Algebraic degree Deg(F) = max degree among coordinate functions
#    Compute ANF coefficients via Möbius transform over GF(2) for each Fi truth table.
# =========================================================
def mobius_anf_inplace(tt: np.ndarray, n: int) -> np.ndarray:
    """
    In-place Möbius transform over GF(2) to convert truth table to ANF coefficients.
    tt: uint8 array of length 2^n with entries 0/1.
    After transform, tt[mask] is coefficient of monomial x^mask in ANF.
    """
    a = tt
    step = 1
    while step < (1 << n):
        a2 = a.reshape(-1, 2*step)
        a2[:, step:2*step] ^= a2[:, :step]
        step *= 2
    return a

def algebraic_degree_from_truth(tt: np.ndarray, n: int) -> int:
    a = tt.astype(np.uint8).copy()
    mobius_anf_inplace(a, n)
    idx1 = np.flatnonzero(a)
    if idx1.size == 0:
        return 0
    # degree is max popcount among masks with coefficient 1
    # Use vectorized popcount on uint32 indices
    masks = idx1.astype(np.uint32)
    masks_bytes = masks.view(np.uint8).reshape(-1, masks.itemsize)
    degs = lut8[masks_bytes].sum(axis=1)
    return int(degs.max())

degF = max(
    algebraic_degree_from_truth(F1, n),
    algebraic_degree_from_truth(F2, n),
    algebraic_degree_from_truth(F3, n),
    algebraic_degree_from_truth(F4, n),
)

print("\n=== Algebraic degree ===")
print(f"Deg(F) = {degF}")
